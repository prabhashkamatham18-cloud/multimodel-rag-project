OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen2.5:latest
# Optional. Install a vision-capable Ollama model separately before enabling.
OLLAMA_VISION_MODEL=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=900
CHUNK_OVERLAP=140
RETRIEVAL_TOP_K=5
UPLOAD_LIMIT_MB=50
OCR_LANGUAGE=eng
# Example Windows path: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
RELEVANCE_THRESHOLD=0.15
